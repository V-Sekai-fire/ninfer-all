<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MPL-2.0
     The ninfer-all MSI for Windows x64: ninfer-serve and its DLL closure (CUDA runtime, FFmpeg,
     the MSVC runtime), Ternary Bonsai 2 27B Uncensored Heretic v2 as a split v3 artifact, and the
     NInfer Windows service. v-sekai/msi.nu stages the tree and builds it with WiX:
       wix build -arch x64 -d Version=... -d Stage=... -o ninfer-all.msi ninfer.wxs
     The model parts are each below 2 GB and each goes into its own external CAB, because
     a CAB and a GitHub release asset are both limited to 2 GB. Keep the .msi and every .cab in
     one folder. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NInfer (Ternary Bonsai 2 27B Heretic v2)"
           Manufacturer="V-Sekai"
           Version="$(var.Version)"
           UpgradeCode="7d0f8f5e-4c1b-4f39-9a52-6b1f0e3c2a91"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">
    <SummaryInformation Description="ninfer-all server for one RTX 4090 with Ternary Bonsai 2 27B Uncensored Heretic v2, as a Windows service" />
    <!-- Dev builds share X.Y.Z and differ in the fourth field, which MSI ignores, so a same-version
         upgrade must still replace the installed build. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer NInfer is already installed." />
    <MediaTemplate EmbedCab="no" CabinetTemplate="ninfer{0}.cab" MaximumUncompressedMediaSize="1800" CompressionLevel="none" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VSekaiDir" Name="V-Sekai">
        <Directory Id="INSTALLFOLDER" Name="NInfer">
          <Directory Id="BinDir" Name="bin" />
          <Directory Id="ModelsDir" Name="models" />
          <Directory Id="LicensesDir" Name="licenses" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataVSekaiDir" Name="V-Sekai">
        <Directory Id="DATAFOLDER" Name="NInfer" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Runtime" Directory="BinDir">
      <Files Include="$(var.Stage)\bin\**" />
    </ComponentGroup>
    <ComponentGroup Id="Model" Directory="ModelsDir">
      <Files Include="$(var.Stage)\models\**" />
    </ComponentGroup>
    <ComponentGroup Id="Notices" Directory="LicensesDir">
      <Files Include="$(var.Stage)\licenses\**" />
    </ComponentGroup>
    <ComponentGroup Id="Extras" Directory="INSTALLFOLDER">
      <File Source="$(var.Stage)\VERSION" />
      <File Source="$(var.Stage)\BUILDINFO.json" />
    </ComponentGroup>

    <!-- The flags file survives upgrades and uninstalls, so local edits stay. -->
    <Component Id="ServeArgs" Directory="DATAFOLDER" NeverOverwrite="yes" Permanent="yes">
      <File Id="ServeArgsFile" Source="$(var.Stage)\ninfer-serve.args" KeyPath="yes" />
    </Component>

    <Component Id="Service" Directory="BinDir">
      <File Id="ServiceExe" Source="$(var.Stage)\service\ninfer-service.exe" KeyPath="yes" />
      <ServiceInstall Id="NInferService"
                      Name="NInfer"
                      DisplayName="NInfer (Bonsai 2 27B)"
                      Description="ninfer-all OpenAI-compatible server for Ternary Bonsai 2 27B Heretic v2. Flags: %ProgramData%\V-Sekai\NInfer\ninfer-serve.args"
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal"
                      Vital="yes" />
      <!-- ninfer-service.exe restarts ninfer-serve itself after an error (10, 30, then every
           60 seconds), so a host without an NVIDIA GPU still installs and the log says why the
           server stops. Wait="no" keeps the install from waiting on the model load. -->
      <ServiceControl Id="NInferControl" Name="NInfer" Start="install" Stop="both" Remove="uninstall" Wait="no" />
    </Component>

    <Feature Id="Main" Title="NInfer" Level="1">
      <ComponentGroupRef Id="Runtime" />
      <ComponentGroupRef Id="Model" />
      <ComponentGroupRef Id="Notices" />
      <ComponentGroupRef Id="Extras" />
      <ComponentRef Id="ServeArgs" />
      <ComponentRef Id="Service" />
    </Feature>
  </Package>
</Wix>
